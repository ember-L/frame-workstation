{
  "name": "frame-workstation",
  "version": "0.1.0",
  "description": "本地视频处理工作台",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --mac dmg --arm64",
    "predist": "node src/distribution.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.frameworkstation.editor",
    "productName": "Frame Workstation",
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "ffmpeg-static@5.3.0": true
  }
}
